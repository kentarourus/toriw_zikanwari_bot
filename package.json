{
  "name": "class-timetable",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/workbook.js --bundle --format=esm --outfile=dist/assets/js/workbook.js --minify",
    "snapshots": "node scripts/update-snapshots.mjs",
    "test": "node --test scripts/test-timetable-dates.mjs && node verify.mjs && node verify-colors.mjs && node verify-site.mjs",
    "build:chat": "esbuild src/chat-markdown.js --bundle --format=esm --outfile=dist/taiwan-chat/markdown.js --minify",
    "build:guide": "node scripts/build-trip-guide.mjs"
  },
  "dependencies": {
    "@mdit/plugin-katex": "1.2.1",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "katex": "0.19.1",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
